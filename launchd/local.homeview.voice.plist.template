<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: launchd/install.sh fills in __APP_DIR__, __LOG_DIR__ and __PYTHON__ and copies it to ~/Library/LaunchAgents. -->
<plist version="1.0"><dict>
  <key>Label</key><string>local.homeview.voice</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON__</string><string>__APP_DIR__/voice/voice.py</string>
  </array>
  <key>WorkingDirectory</key><string>__APP_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__LOG_DIR__/voice.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/voice.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict></plist>
